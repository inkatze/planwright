#!/bin/sh
# planwright commit-msg backstop (guard-coverage Task 2; D-2; REQ-A1.2):
# reject squash!/fixup!/amend! subjects — the autosquash markers
# `git commit --squash/--fixup[=amend:]` generate, in any flag position
# (the subject prefix is the invariant carrier, so flag order cannot evade
# it). A missing or unreadable message file fails closed. Bypass:
# --no-verify (the human's deliberate escape hatch).
#
# Task 3 (D-5; REQ-B1.1) adds the second screen at the bottom: the message is
# checked against the hashed purged-identifier seed list before it becomes
# permanent history. A commit message sits outside the tracked tree the
# `check` aggregate scans, yet it publishes just as permanently, so write time
# is where that vector closes; CI backs this with a range scan covering the
# clones and fork PRs the hook never runs in.
#
# args: $1 = commit-message file.
set -u
LC_ALL=C
export LC_ALL
unset CDPATH

if [ $# -lt 1 ] || [ ! -f "${1}" ] || [ ! -r "${1}" ]; then
  echo "planwright githooks: commit-msg: no readable message file argument; failing closed" >&2
  exit 1
fi
# The subject is the first non-blank, non-comment line: git applies message
# cleanup (comment stripping) AFTER this hook runs, so scanning past
# '#'-comment lines keeps a comment-first file from shadowing the real
# subject. Assumes the default core.commentChar '#'; with a custom comment
# char a '#'-first subject is skipped and a later line is screened instead —
# acceptable for an accident-catcher. Zero forks: pure read builtins (this
# runs on every commit). The `|| [ -n ... ]` arm keeps a final line without
# a trailing newline in scope.
subject=
while IFS= read -r line || [ -n "$line" ]; do
  case $line in
    "#"* | "") continue ;;
  esac
  subject=$line
  break
done <"$1"
case $subject in
  "squash!"* | "fixup!"* | "amend!"*)
    echo "planwright githooks: commit-msg: refusing '${subject%%!*}!' subject" \
      "(append-only history, never-squash/fixup/amend invariant)" >&2
    exit 1
    ;;
esac

# ---- purged-identifier screen (Task 3; D-5; REQ-B1.1, REQ-H1.3).
# Unlike the subject check above this one forks (a single perl pass over the
# message) — the per-commit latency D-2 records as an accepted residual. The
# scanner owns the normalization, so hook and `check` aggregate can never
# drift into screening different shapes.
#
# Fails closed when the scanner or its seed file is unreachable: a wired clone
# that can write history but cannot screen it is exactly the hole this closes.
# Hooks resolve through the relative `core.hooksPath=githooks`, so the hook
# running is always the one from the checked-out branch, which carries the
# scanner beside it; a checkout old enough to lack the scanner runs its own
# older hook and never reaches this line.
if ! top=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "planwright githooks: commit-msg: cannot resolve the work tree for the" \
    "purged-identifier screen; failing closed" >&2
  exit 1
fi
screen="$top/scripts/check-purged-identifiers.sh"
if [ ! -x "$screen" ]; then
  echo "planwright githooks: commit-msg: $screen missing or not executable;" \
    "failing closed rather than committing an unscreened message" >&2
  exit 1
fi
if ! "$screen" --message-file "$1" >/dev/null; then
  echo "planwright githooks: commit-msg: refusing the message above" \
    "(purged identifiers stay purged; reword rather than widening the guard)" >&2
  exit 1
fi
exit 0
