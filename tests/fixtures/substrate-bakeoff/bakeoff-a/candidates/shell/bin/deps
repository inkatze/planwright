#!/bin/sh
# deps — bake-off A's dependency-line parser, hardened-shell candidate. The
# contract is proto_deps's in ../lib/proto.sh.
case $0 in
  */*) proto_lib=${0%/*}/../lib ;;
  *) proto_lib=../lib ;;
esac
if [ ! -f "$proto_lib/proto.sh" ] || [ ! -r "$proto_lib/proto.sh" ]; then
  printf '%s\n' "deps: proto.sh missing or unreadable under $proto_lib" >&2
  exit 2
fi
# shellcheck source=../lib/proto.sh
. "$proto_lib/proto.sh" || exit 2
proto_deps "$@"
