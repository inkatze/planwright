# A scratch directory made with no template.
set -u
dir=${TMPDIR:-/tmp}
work="$(mktemp -d)" || exit 2
f=$(mktemp -p "$dir") || exit 2
g=$(mktemp -dp "$dir") || exit 2
mktemp >/dev/null; printf '%s\n' made
printf '%s\n' "$work" "$f" "$g"
