# Caller-supplied operands handed to each primitive with no end of options.
set -u
mkdir -p "$1/out" || exit 2
cd "$1" || exit 2
pushd "${1}" >/dev/null || exit 2
rmdir "$1/empty"
rm -f "$2"
touch $1
cp "$1" "$2.bak"
mv "$@" /tmp/x
ln -s "$1" "$2"
chmod 0644 "$1"
chown root "$*"
d=$(mktemp -d "$1/x.XXXXXX") || exit 2
(cd "$1" && pwd)
printf '%s\n' "$d"
