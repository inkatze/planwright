# A failed gh read becomes an empty list, read as "no open PRs".
set -u
prs=$(gh pr list --json number) || true
n=$(gh pr list --json number) || :
m=$(gh pr list --json number) 2>/dev/null || true
o=`gh pr list --json number` || true
q="open: $(gh pr list --json number)" || true
r=$(gh pr list --json number) 2> /dev/null || true
u=$(gh pr list --json number) </dev/null || true
[ -n "$prs$n$m$o$q$r$u" ] || printf '%s\n' "no open PRs"
