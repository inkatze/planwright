# Each GNU-only option, combined short flags included.
set -u
mtime=$(stat -c %Y "$0") || exit 2
size=$(stat --format=%s "$0") || exit 2
timeout 5 true
p=$(readlink -f "$0") || exit 2
d=$(date -d @0 +%Y) || exit 2
grep -oP 'a+' "$0" >/dev/null
grep -2P 'a+' "$0" >/dev/null
printf '%s\0' "$0" | xargs -0r ls >/dev/null
printf '%s\n' "$0" | xargs --no-run-if-empty ls >/dev/null
printf '%s\n' 1.10 1.9 | sort -V >/dev/null
sed -i 's/a/b/' "$0.copy"
find . -name x -printf '%p\n'
p=$(readlink -nf "$0") || exit 2
printf '%s\n' "$mtime" "$size" "$p" "$d"
